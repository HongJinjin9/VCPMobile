{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "ios-main",
  "description": "iOS main-window APIs; native plugin grants are added only when their adapters are implemented",
  "windows": ["main"],
  "platforms": ["iOS"],
  "permissions": [
    "core:default",
    "opener:default",
    "vcp-mobile:allow-get-notification-permission",
    "vcp-mobile:allow-request-notification-permission",
    "vcp-mobile:allow-open-notification-settings",
    "vcp-mobile:allow-get-pending-notification",
    "vcp-mobile:allow-get-battery-status"
  ]
}
